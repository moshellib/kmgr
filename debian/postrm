#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if [ -x /usr/bin/deb-systemd-helper ]; then
    case "$1" in
    remove)
        deb-systemd-helper mask kmgr_uut.service kmgr_gu.service >/dev/null || true
        ;;
    purge)
        deb-systemd-helper purge kmgr_uut.service kmgr_gu.service >/dev/null || true
        deb-systemd-helper unmask kmgr_uut.service kmgr_gu.service >/dev/null || true
        ;;
    esac
fi

#DEBHELPER#
